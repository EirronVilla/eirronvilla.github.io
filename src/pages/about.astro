---
import { getEntry, render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';

const about = await getEntry('blog', 'about');

if (!about) {
	throw new Error('No se encontro el contenido src/content/blog/about.md');
}

const { Content } = await render(about);
---

<BlogPost {...about.data}>
	<Content />
</BlogPost>
