---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/index.css';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const articles = [
	['Productividad', 'Pequenos cambios, mejores dias', '12 abr 2024', '4 min de lectura', 'waves'],
	['Perspectiva', 'El espacio intermedio', '8 abr 2024', '5 min de lectura', 'glow'],
	['Humanidad', 'Una version mas amable de ti', '3 abr 2024', '6 min de lectura', 'circles'],
	['Atencion plena', 'Claridad entre el ruido', '28 mar 2024', '5 min de lectura', 'slope'],
];
---
<!doctype html>
<html lang="es">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<canvas id="hero-mandelbrot" class="mandelbrot-background" aria-hidden="true"></canvas>
				<p class="aside left">Ideas<br />para un<br />manana<br />mas sereno<i></i></p>
				<div class="hero-copy"><h1>Vivir<br />mejor.</h1><p>Una mente mas clara</p><a class="pill" href="/blog">Explorar &gt;</a></div>
				<p class="aside right">Curiosidad<br />humanidad<br />un manana<br />mas amable<i></i></p>
				<p class="scroll">Desliza</p><div class="slider"><b>01 / 03</b><button aria-label="Anterior">&lt;</button><button aria-label="Siguiente">&gt;</button></div>
			</section>
			<section class="block featured">
				<div class="heading"><h2>Destacado</h2><a href="/blog">Ver todo &gt;</a></div>
				<div class="feature-grid">
					<div class="feature-art"><i></i><span>01</span></div>
					<article class="feature-copy"><p class="label">Perspectiva</p><h3>Un futuro<br />mas sereno</h3><p>Como una mirada mas consciente<br />transforma lo que viene.</p><a href="/blog">Leer mas &gt;</a></article>
					<div class="stories"><a href="/blog"><i class="mini blur"></i><span><b>Bienestar</b>El poder de lo esencial</span>&gt;</a><a href="/blog"><i class="mini lines"></i><span><b>Tecnologia</b>Una internet mas humana</span>&gt;</a><a href="/blog"><i class="mini eclipse"></i><span><b>Estilo de vida</b>Rituales para una mente clara</span>&gt;</a></div>
				</div>
			</section>
			<section class="block latest">
				<div class="heading"><h2>Ultimos articulos</h2><a href="/blog">Ver todo &gt;</a></div>
				<div class="cards">{articles.map(([category, title, date, time, art]) => <article><a class={`art ${art}`} href="/blog"><i></i></a><p class="label">{category}</p><h3><a href="/blog">{title}</a></h3><p class="meta">{date} / {time}</p></article>)}</div>
			</section>
		</main>
		<Footer />
		<script>
			import '../scripts/mandelbrot';
		</script>
	</body>
</html>
